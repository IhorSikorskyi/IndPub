{
  "ConnectionStrings": {
    "IndPubConnection": "Host=localhost;Database=your_db;Username=your_user;Password=your_password;"
  },
  "AppSettings": {
    "AccessToken": "your_jwt_secret_key",
    "Issuer": "your_issuer",
    "Audience": "your_audience"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TokenCleanup": {
    "IntervalHours": 24
  },
  "UpdateBookRating": {
    "IntervalHours": 1
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "AzureStorage": {
    "ConnectionString": "your_azure_storage_connection_string"
  },
  "AllowedHosts": "*"
}